/* Devicetree overlay for the CoolingDock-equivalent build on the
 * nRF52832 DK (PCA10040). Pin labels are the on-board silkscreen
 * Pn.mm format (port n, pin mm); see the silkscreen on the board
 * back-side or refer to the PCA10040 hardware files for physical
 * header positions.
 *
 * Pin map:
 *   P0.27   I2C0 SCL        -> SHT3x SCL
 *   P0.26   I2C0 SDA        -> SHT3x SDA
 *   P0.13   PWM0 channel 0  -> Fan PWM   (22 kHz)
 *   P0.14   GPIO out        -> Fan power gate (active-high)
 */

#include <zephyr/dt-bindings/pwm/pwm.h>

/* ------------------------------------------------------------------ pinctrl */

&pinctrl {
	pwm0_default: pwm0_default {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 13)>;
		};
	};

	pwm0_sleep: pwm0_sleep {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 13)>;
			low-power-enable;
		};
	};
};

/* P0.13 / P0.14 are also BUTTON1 / BUTTON2 on PCA10040; we use them as
 * fan PWM and fan-power-gate outputs, so disable the board's button
 * nodes for those pins to prevent a future Kconfig flip from claiming
 * them under us. */
&button0 { status = "disabled"; };
&button1 { status = "disabled"; };

/* --------------------------------------------------------------------- I2C0 */

&i2c0 {
	status = "okay";
	/* nRF52 TWI peripheral only accepts 100 kHz / 250 kHz / 400 kHz
	 * (any other value triggers a build-time BUILD_ASSERT). Stick
	 * with standard 100 kHz; if the bus is marginal because of weak
	 * pull-ups, the fix is to add physical 4.7 kΩ resistors to
	 * VDD on SDA + SCL — slowing the clock isn't an option here. */
	clock-frequency = <I2C_BITRATE_STANDARD>;

	sht3x: sht3xd@45 {
		compatible = "sensirion,sht3xd";
		reg = <0x45>;     /* SHT3x ADDR pin tied to VDD. Tie ADDR to GND for 0x44. */
	};
};

/* --------------------------------------------------------------------- PWM0 */

&pwm0 {
	status = "okay";
	pinctrl-0 = <&pwm0_default>;
	pinctrl-1 = <&pwm0_sleep>;
	pinctrl-names = "default", "sleep";
};

/* ---------------------------------------------- application aliases / nodes */

/ {
	fan_pwms {
		compatible = "pwm-leds";
		status = "okay";
		fan_pwm_ch: fan_pwm_ch {
			pwms = <&pwm0 0 PWM_HZ(22000) PWM_POLARITY_NORMAL>;
		};
	};

	fan_power_gpios {
		compatible = "gpio-leds";
		status = "okay";
		fan_power: fan_power {
			gpios = <&gpio0 14 GPIO_ACTIVE_HIGH>;
		};
	};

	aliases {
		fan-pwm     = &fan_pwm_ch;
		fan-power   = &fan_power;
		sht3x       = &sht3x;
		/* BUTTON3 on PCA10040 (P0.15). Hold for 5 s to reopen the
		 * 120 s BLE pairing window. The DK board file already
		 * declares button2 with proper GPIO_PULL_UP|ACTIVE_LOW. */
		pairing-btn = &button2;
	};
};
